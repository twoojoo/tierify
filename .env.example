# Server Configuration
PORT=8080
HOST=0.0.0.0
READ_TIMEOUT=15s
WRITE_TIMEOUT=15s

# Database Configuration
DB_TYPE=sqlite
DB_CONNECTION_STRING=tierify.db
# DB_TYPE=postgres
# DB_CONNECTION_STRING=postgres://tierify:tierify@localhost:5432/tierify?sslmode=disable
DB_MAX_OPEN_CONNS=25
DB_MAX_IDLE_CONNS=5
DB_CONN_MAX_LIFETIME=5m

# Behavior
ALLOW_USAGE_BELOW_ZERO=false

# Logging
LOG_LEVEL=info
LOG_FORMAT=json
